function detectMarketRegime(d) {
    const { closes, highs, lows, atr, price } = d;
    const n = closes.length;
    let plusDM = 0, minusDM = 0, tr = 0;
    for (let i = 1; i < Math.min(n, 20); i++) {
        const upMove = highs[i] - highs[i-1];
        const downMove = lows[i-1] - lows[i];
        const trVal = Math.max(highs[i] - lows[i], Math.abs(highs[i] - closes[i-1]), Math.abs(lows[i] - closes[i-1]));
        tr += trVal;
        if (upMove > downMove && upMove > 0) plusDM += upMove;
        else if (downMove > upMove && downMove > 0) minusDM += downMove;
    }
    const atrVal = tr / 20;
    const adx = atrVal > 0 ? 100 * Math.abs(plusDM - minusDM) / (plusDM + minusDM + 0.001) : 25;
    const recentVol = closes.slice(-20).reduce((a,b,i,arr) => {
        if (i === 0) return a;
        return a + Math.abs(b - arr[i-1]);
    }, 0) / 20 / price;
    const longTermVol = closes.slice(-100).reduce((a,b,i,arr) => {
        if (i === 0) return a;
        return a + Math.abs(b - arr[i-1]);
    }, 0) / 100 / price;
    const volRatio = recentVol / (longTermVol + 0.001);
    const rsi = d.rsi || 50;
    const range = Math.max(...highs.slice(-50)) - Math.min(...lows.slice(-50));
    const rangeRatio = range / (atrVal + 0.001);
    let regime = 'NEUTRAL';
    let strength = 50;
    if (adx > 40 && volRatio > 1.2) { regime = 'STRONG_TREND'; strength = 85; }
    else if (adx > 30 && volRatio > 0.8) { regime = 'TRENDING'; strength = 70; }
    else if (rangeRatio < 5 && volRatio < 0.7) { regime = 'RANGING'; strength = 65; }
    else if (volRatio > 1.5 && adx < 25) { regime = 'CHOPPY'; strength = 30; }
    else if (rsi > 70 || rsi < 30) { regime = 'EXTREME'; strength = 75; }
    return { regime, strength };
}

function getOptimalEntryTiming(d, signal, forecast) {
    const { price, atr, rsi } = d;
    const isBuy = signal === 'BUY' || signal === 'SCALP-LONG' || signal === 'OPTION-CALL' || signal === 'OPTION-BULL-SPREAD';
    const entry = forecast.entry;
    const sl = forecast.sl;
    const distToEntry = Math.abs(price - entry);
    const distToSL = Math.abs(entry - sl);
    const entryProgress = distToEntry / (distToSL + 0.001);
    let timing = 'WAIT';
    let timingScore = 0;
    let reason = [];
    if (entryProgress < 0.2) { timing = 'IMMINENT'; timingScore = 90; reason.push('Price at entry zone'); }
    else if (entryProgress < 0.4) { timing = 'APPROACHING'; timingScore = 70; reason.push('Price approaching entry zone'); }
    else if (entryProgress < 0.6) { timing = 'CLOSE'; timingScore = 50; reason.push('Price is close to entry'); }
    else { timing = 'FAR'; timingScore = 20; reason.push('Price far from entry, wait'); }
    if (isBuy && rsi < 40) { timingScore += 10; reason.push('RSI oversold'); }
    else if (!isBuy && rsi > 60) { timingScore += 10; reason.push('RSI overbought'); }
    return { timing, timingScore: Math.min(100, timingScore), reason: reason.join(', ') };
}

function optimizeRisk(d, signal, forecast, accountBalance, riskPercent) {
    const { atr, rsi, price } = d;
    const isBuy = signal === 'BUY' || signal === 'SCALP-LONG' || signal === 'OPTION-CALL' || signal === 'OPTION-BULL-SPREAD';
    const entry = forecast.entry;
    const sl = forecast.sl;
    let baseRisk = riskPercent || 1;
    const atrPercent = atr / price;
    let volMultiplier = 1;
    if (atrPercent > 0.02) volMultiplier = 0.7;
    else if (atrPercent < 0.005) volMultiplier = 1.3;
    let rsiMultiplier = 1;
    if ((isBuy && rsi > 70) || (!isBuy && rsi < 30)) rsiMultiplier = 0.5;
    else if ((isBuy && rsi < 30) || (!isBuy && rsi > 70)) rsiMultiplier = 1.2;
    const regime = detectMarketRegime(d);
    let regimeMultiplier = 1;
    if (regime.regime === 'STRONG_TREND') regimeMultiplier = 1.2;
    else if (regime.regime === 'CHOPPY') regimeMultiplier = 0.6;
    else if (regime.regime === 'RANGING') regimeMultiplier = 0.9;
    const distToEntry = Math.abs(price - entry);
    const distToSL = Math.abs(entry - sl);
    let entryMultiplier = 1;
    if (distToEntry < distToSL * 0.2) entryMultiplier = 1.3;
    else if (distToEntry > distToSL * 0.8) entryMultiplier = 0.7;
    let optimalRisk = baseRisk * volMultiplier * rsiMultiplier * regimeMultiplier * entryMultiplier;
    optimalRisk = Math.max(0.25, Math.min(3, optimalRisk));
    const riskUSD = (optimalRisk / 100) * accountBalance;
    const pips = Math.abs(entry - sl);
    let pipVal = 100000;
    if (curAsset === 'XAUUSD') pipVal = 100;
    else if (curAsset === 'BTCUSD') pipVal = 1;
    else if (curAsset === 'XAGUSD') pipVal = 5000;
    const lotSize = Math.min(10, Math.max(0.01, riskUSD / (pips * pipVal + 0.001)));
    return { optimalRisk: parseFloat(optimalRisk.toFixed(2)), lotSize: parseFloat(lotSize.toFixed(2)), riskUSD: parseFloat(riskUSD.toFixed(2)) };
}

function calculateTradeQuality(d, signal, forecast, timing, riskOptimized) {
    const { price, atr, rsi, structure } = d;
    const isBuy = signal === 'BUY' || signal === 'SCALP-LONG' || signal === 'OPTION-CALL' || signal === 'OPTION-BULL-SPREAD';
    let qualityScore = 0;
    let reasons = [];
    let signalScore = Math.min(20, (forecast.conf || 50) / 5);
    qualityScore += signalScore;
    reasons.push('Signal: ' + signalScore.toFixed(0) + '/20');
    let timingScore = Math.min(20, timing.timingScore / 5);
    qualityScore += timingScore;
    reasons.push('Timing: ' + timingScore.toFixed(0) + '/20');
    const regime = detectMarketRegime(d);
    let regimeScore = 0;
    if (regime.regime === 'STRONG_TREND') regimeScore = 15;
    else if (regime.regime === 'TRENDING') regimeScore = 12;
    else if (regime.regime === 'RANGING') regimeScore = 10;
    else if (regime.regime === 'EXTREME') regimeScore = 8;
    else regimeScore = 5;
    qualityScore += regimeScore;
    reasons.push('Regime: ' + regimeScore.toFixed(0) + '/15');
    const rr = parseFloat(forecast.rr) || 0;
    let rrScore = 0;
    if (rr >= 3) rrScore = 15;
    else if (rr >= 2) rrScore = 12;
    else if (rr >= 1.5) rrScore = 8;
    else if (rr >= 1) rrScore = 5;
    else rrScore = 2;
    qualityScore += rrScore;
    reasons.push('R:R ' + rr + ': ' + rrScore.toFixed(0) + '/15');
    let rsiScore = 0;
    if (isBuy && rsi < 35) rsiScore = 10;
    else if (isBuy && rsi < 45) rsiScore = 7;
    else if (!isBuy && rsi > 65) rsiScore = 10;
    else if (!isBuy && rsi > 55) rsiScore = 7;
    else rsiScore = 3;
    qualityScore += rsiScore;
    reasons.push('RSI: ' + rsiScore.toFixed(0) + '/10');
    let structScore = 0;
    if (isBuy && structure === 'BULLISH') structScore = 10;
    else if (!isBuy && structure === 'BEARISH') structScore = 10;
    else if (structure === 'RANGING') structScore = 5;
    else structScore = 2;
    qualityScore += structScore;
    reasons.push('Structure: ' + structScore.toFixed(0) + '/10');
    let riskScore = 0;
    if (riskOptimized.optimalRisk >= 0.5 && riskOptimized.optimalRisk <= 2) riskScore = 10;
    else if (riskOptimized.optimalRisk >= 0.3 && riskOptimized.optimalRisk <= 2.5) riskScore = 7;
    else riskScore = 3;
    qualityScore += riskScore;
    reasons.push('Risk: ' + riskScore.toFixed(0) + '/10');
    const finalQuality = Math.min(100, qualityScore);
    let grade = 'F';
    let recommendation = 'AVOID';
    if (finalQuality >= 85) { grade = 'A+'; recommendation = 'AGGRESSIVE'; }
    else if (finalQuality >= 75) { grade = 'A'; recommendation = 'STRONG'; }
    else if (finalQuality >= 65) { grade = 'B'; recommendation = 'MODERATE'; }
    else if (finalQuality >= 55) { grade = 'C'; recommendation = 'CAUTIOUS'; }
    else if (finalQuality >= 40) { grade = 'D'; recommendation = 'WEAK'; }
    else { grade = 'F'; recommendation = 'AVOID'; }
    return { qualityScore: finalQuality, grade, recommendation, reasons: reasons.join(' | '), regime: regime };
}

function calculateAdvancedExits(activeTrade, price, atr) {
    const isBuy = activeTrade.signal === 'BUY' || activeTrade.signal === 'SCALP-LONG' || activeTrade.signal === 'OPTION-CALL' || activeTrade.signal === 'OPTION-BULL-SPREAD';
    const pips = isBuy ? price - activeTrade.entry : activeTrade.entry - price;
    const risk = Math.abs(activeTrade.entry - activeTrade.originalSL);
    let exits = [];
    if (pips >= risk * 1.5) {
        exits.push({ type: 'SCALE_OUT_50', price: isBuy ? activeTrade.entry + risk * 1.5 : activeTrade.entry - risk * 1.5, size: 0.5, reason: '50% profit target' });
    }
    if (pips >= risk * 2.0) {
        exits.push({ type: 'SCALE_OUT_25', price: isBuy ? activeTrade.entry + risk * 2.0 : activeTrade.entry - risk * 2.0, size: 0.25, reason: '25% additional profit' });
    }
    if (activeTrade.tf === '1min' || activeTrade.tf === '5min') {
        const timeElapsed = (Date.now() - activeTrade.openTime) / 60000;
        if (timeElapsed > 10 && pips < risk * 0.3) {
            exits.push({ type: 'TIME_EXIT', price: price, size: 1.0, reason: 'Time exit after ' + Math.round(timeElapsed) + 'min' });
        }
    }
    return exits;
}


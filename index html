    const isBearish = cfdSignal === 'SELL' || cfdSignal === 'SCALP-SHORT';
    
    // Estimate IV from volatility
    const ivRank = Math.min(95, Math.max(5, 50 + (vol - 15) * 2));
    const highIV = ivRank > 65;
    const lowIV = ivRank < 35;
    
    let strategy = 'HOLD';
    let strike = price;
    let premium = 0;
    let maxProfit = 0;
    let maxLoss = 0;
    let breakEven = price;
    let expiry = '7DTE';
    let delta = 0;
    let theta = 0;
    let probITM = 0;
    let strategyName = 'No Signal';
    let description = '';
    
    if (isBullish && !isBearish) {
        if (lowIV) {
            strategy = 'OPTION-CALL';
            strategyName = 'Buy Call';
            strike = price + (atr * 0.3);
            premium = (atr * 0.15) * (1 - ivRank/200);
            maxProfit = 'Unlimited';
            maxLoss = '$' + premium.toFixed(2);
            breakEven = strike + premium;
            delta = 0.55 + (1 - (ivRank/100)) * 0.2;
            theta = -0.02 - (ivRank/5000);
            probITM = 45 + (ivRank/4);
            description = 'Bullish + Low IV = Buy cheap calls';
        } else if (highIV) {
            strategy = 'OPTION-BULL-SPREAD';

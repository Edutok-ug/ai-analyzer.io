async function testGroqKey(key){
  const resultEl=document.getElementById('groqTestResult');
  if(!key || key.length<10){
    resultEl.innerHTML='❌ Please enter a valid Groq API key (starts with gsk_)';
    resultEl.style.color='var(--red)';
    return false;
  }
  resultEl.innerHTML='🔍 Testing Groq API...';
  resultEl.style.color='var(--sub)';
  try{
    const r=await fetch('https://api.groq.com/openai/v1/chat/completions',{
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},
      body:JSON.stringify({model:'llama3-8b-8192',max_tokens:50,messages:[{role:'user',content:'Say "API working" in 5 words or less.'}]})
    });
    const j=await r.json();
    if(j.choices && j.choices[0]){
      resultEl.innerHTML='✅ <strong style="color:var(--green);">Groq API key is valid!</strong> Response: "'+j.choices[0].message.content+'"';
      resultEl.style.color='var(--green)';
      groqKey=key;
      localStorage.setItem('qep_groq',key);
      document.getElementById('groqStatusPill').textContent='🤖 GROQ: ON';
      document.getElementById('groqStatusPill').className='pill pill-purple';
      addLog('✅ Groq API key validated and saved','api');
      return true;
    } else {
      resultEl.innerHTML='❌ Invalid Groq API key. Error: '+(j.error?.message||'Unknown error');
      resultEl.style.color='var(--red)';
      return false;
    }
  }catch(e){
    resultEl.innerHTML='❌ Network error: '+e.message;
    resultEl.style.color='var(--red)';
    return false;
  }
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
<title>Quantum Edge Pro v4 | Trading System</title>
<script src="https://s3.tradingview.com/tv.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;700;800&display=swap" rel="stylesheet" />
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#05070f;
  --panel:#0c1526;
  --border:#1e2d4a;
  --gold:#f59e0b;
  --gold-glow:#f59e0b55;
  --green:#10b981;
  --red:#ef4444;
  --blue:#3b82f6;
  --purple:#8b5cf6;
  --text:#eef2ff;
  --muted:#64748b;
  --sub:#94a3b8;
  --ff:'Syne',sans-serif;
  --fm:'Space Mono',monospace;
}
body{
  font-family:var(--ff);
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
  position:relative;
}
/* Glowing Stars Background */
body::before{
  content:'✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★';
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  font-size:3rem;
  color:transparent;
  background-image:radial-gradient(2px 2px at 10% 20%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(3px 3px at 30% 60%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(2px 2px at 50% 10%, rgba(245,158,11,0.4), transparent),
                    radial-gradient(4px 4px at 70% 80%, rgba(245,158,11,0.15), transparent),
                    radial-gradient(2px 2px at 90% 40%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(3px 3px at 15% 90%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(2px 2px at 45% 50%, rgba(245,158,11,0.35), transparent),
                    radial-gradient(2px 2px at 75% 30%, rgba(245,158,11,0.25), transparent),
                    radial-gradient(3px 3px at 85% 70%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(2px 2px at 5% 5%, rgba(245,158,11,0.4), transparent),
                    radial-gradient(2px 2px at 95% 95%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(3px 3px at 25% 75%, rgba(245,158,11,0.15), transparent),
                    radial-gradient(2px 2px at 65% 15%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(2px 2px at 55% 85%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(3px 3px at 35% 45%, rgba(245,158,11,0.25), transparent);
  background-repeat:no-repeat;
  pointer-events:none;
  z-index:0;
  animation:twinkle 4s ease-in-out infinite alternate;
}
@keyframes twinkle{
  0%{opacity:0.5;}
  50%{opacity:1;}
  100%{opacity:0.5;}
}
/* Additional floating stars with glow */
body::after{
  content:'✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★ ✦ ✧ ★';
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  font-size:4rem;
  color:transparent;
  background-image:radial-gradient(2px 2px at 12% 35%, rgba(245,158,11,0.25), transparent),
                    radial-gradient(3px 3px at 38% 15%, rgba(245,158,11,0.15), transparent),
                    radial-gradient(2px 2px at 62% 55%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(2px 2px at 88% 25%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(3px 3px at 42% 70%, rgba(245,158,11,0.15), transparent),
                    radial-gradient(2px 2px at 78% 50%, rgba(245,158,11,0.25), transparent),
                    radial-gradient(2px 2px at 8% 60%, rgba(245,158,11,0.3), transparent),
                    radial-gradient(3px 3px at 92% 10%, rgba(245,158,11,0.2), transparent),
                    radial-gradient(2px 2px at 18% 85%, rgba(245,158,11,0.15), transparent),
                    radial-gradient(2px 2px at 72% 90%, rgba(245,158,11,0.25), transparent);
  background-repeat:no-repeat;
  pointer-events:none;
  z-index:0;
  animation:twinkle2 5s ease-in-out infinite alternate;
}
@keyframes twinkle2{
  0%{opacity:0.3;}
  33%{opacity:0.8;}
  66%{opacity:0.4;}
  100%{opacity:0.7;}
}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:#0a0f1f;}
::-webkit-scrollbar-thumb{background:var(--gold);border-radius:4px;}

@keyframes ta{0%{opacity:0;transform:translateX(-50%) translateY(20px);}15%{opacity:1;transform:translateX(-50%) translateY(0);}85%{opacity:1;transform:translateX(-50%) translateY(0);}100%{opacity:0;transform:translateX(-50%) translateY(-10px);}}

.dashboard{display:block;position:relative;z-index:1;}
.topnav{
  background:linear-gradient(90deg,#080e1f,#0d1a30);
  border-bottom:1px solid var(--border);
  padding:12px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:10px;
  position:sticky;
  top:0;
  z-index:100;
}
.brand h1{
  font-size:1.2rem;
  font-weight:800;
  background:linear-gradient(135deg,var(--gold),#f97316);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.brand sub{
  font-size:0.6rem;
  color:var(--sub);
  letter-spacing:1px;
}
.nav-right{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  align-items:center;
}
.pill{
  padding:3px 12px;
  border-radius:40px;
  font-size:0.65rem;
  font-weight:700;
  border:1px solid;
}
.pill-green{background:#10b98122;border-color:var(--green);color:var(--green);animation:pulse 2s infinite;}
.pill-gold{background:#f59e0b22;border-color:var(--gold);color:var(--gold);}
.pill-blue{background:#3b82f622;border-color:var(--blue);color:var(--blue);}
.pill-purple{background:#8b5cf622;border-color:var(--purple);color:var(--purple);}
.pill-muted{background:#64748b22;border-color:var(--muted);color:var(--muted);}
@keyframes pulse{0%,100%{opacity:.7;}50%{opacity:1;}}
.tabs{
  display:flex;
  gap:2px;
  padding:14px 20px 0;
  background:#080e1f;
  overflow-x:auto;
  border-bottom:1px solid var(--border);
}
.tab{
  background:none;
  border:none;
  color:var(--sub);
  padding:9px 18px;
  border-radius:8px 8px 0 0;
  font-family:var(--ff);
  font-size:0.75rem;
  font-weight:700;
  cursor:pointer;
  transition:.15s;
  white-space:nowrap;
  border-bottom:2px solid transparent;
}
.tab.on{color:var(--gold);border-bottom-color:var(--gold);}
.tab:hover:not(.on){color:var(--text);}
.page{display:none;padding:18px 20px 90px;}
.page.on{display:block;}
.panel{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:18px;
  padding:18px;
  margin-bottom:16px;
}
.ptitle{
  font-size:0.68rem;
  font-weight:700;
  color:var(--sub);
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:12px;
}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.g6{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;}
select,input[type=number],input[type=text]{
  width:100%;
  padding:9px 13px;
  background:#080e1f;
  border:1px solid var(--border);
  border-radius:10px;
  color:var(--text);
  font-family:var(--ff);
  font-size:0.82rem;
  outline:none;
  transition:.2s;
}
select:focus,input:focus{border-color:var(--gold);}
.plabel{
  font-size:0.6rem;
  color:var(--sub);
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:5px;
}
.btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:9px 20px;
  border-radius:10px;
  font-weight:700;
  font-size:0.78rem;
  cursor:pointer;
  transition:.15s;
  border:none;
  font-family:var(--ff);
}
.btn:hover:not(:disabled){filter:brightness(1.12);transform:translateY(-1px);}
.btn-gold{background:var(--gold);color:#080e1f;}
.btn-green{background:var(--green);color:#080e1f;}
.btn-red{background:var(--red);color:#fff;}
.btn-ghost{background:#1e2d4a;color:var(--text);}
.btn-purple{background:var(--purple);color:#fff;}
.btn-sm{padding:6px 13px;font-size:0.72rem;}
.sig-card{
  border:1px solid var(--border);
  border-radius:18px;
  padding:20px;
  margin-bottom:16px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#0c1526,#080e1f);
}
.sig-card::before{
  content:'';
  position:absolute;
  top:0;left:0;right:0;height:3px;
  border-radius:18px 18px 0 0;
}
.sig-card.BUY::before,.sig-card.SCALP-LONG::before{background:linear-gradient(90deg,var(--green),transparent);}
.sig-card.SELL::before,.sig-card.SCALP-SHORT::before{background:linear-gradient(90deg,var(--red),transparent);}
.sig-card.HOLD::before{background:linear-gradient(90deg,var(--gold),transparent);}
.sig-card.OPTION-CALL::before{background:linear-gradient(90deg,var(--blue),transparent);}
.sig-card.OPTION-PUT::before{background:linear-gradient(90deg,var(--purple),transparent);}
.sig-card.OPTION-BULL-SPREAD::before{background:linear-gradient(90deg,var(--green),var(--blue));}
.sig-card.OPTION-BEAR-SPREAD::before{background:linear-gradient(90deg,var(--red),var(--purple));}
.sig-card.OPTION-IRON-CONDOR::before{background:linear-gradient(90deg,var(--gold),var(--blue));}
.sbadge{
  font-size:2.2rem;
  font-weight:800;
  letter-spacing:2px;
  font-family:var(--fm);
}
.sbadge.BUY,.sbadge.SCALP-LONG{color:var(--green);}
.sbadge.SELL,.sbadge.SCALP-SHORT{color:var(--red);}
.sbadge.HOLD{color:var(--gold);}
.sbadge.OPTION-CALL{color:var(--blue);}
.sbadge.OPTION-PUT{color:var(--purple);}
.sbadge.OPTION-BULL-SPREAD{color:var(--green);}
.sbadge.OPTION-BEAR-SPREAD{color:var(--red);}
.sbadge.OPTION-IRON-CONDOR{color:var(--gold);}
.mtile{
  background:#080e1f;
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px;
  text-align:center;
}
.mtile .ml{
  font-size:0.58rem;
  color:var(--sub);
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:5px;
}
.mtile .mv{font-size:1rem;font-weight:700;font-family:var(--fm);}
.forecast-card{
  background:#080e1f;
  border-radius:14px;
  padding:16px;
  border:1px solid var(--border);
  margin-bottom:12px;
}
.forecast-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:6px 0;
  border-bottom:1px solid #1e2d4a22;
}
.forecast-row:last-child{border:none;}
.forecast-label{
  font-size:0.65rem;
  color:var(--sub);
  text-transform:uppercase;
  letter-spacing:1px;
}
.forecast-value{font-size:0.95rem;font-weight:700;font-family:var(--fm);}
.entry-progress{height:6px;background:#1e2d4a;border-radius:10px;overflow:hidden;margin:8px 0;}
.entry-progress-fill{height:100%;background:linear-gradient(90deg,var(--red),var(--gold),var(--green));border-radius:10px;transition:width .5s;}
.entry-status-badge{padding:4px 12px;border-radius:20px;font-size:0.7rem;font-weight:700;}
.es-waiting{background:#f59e0b22;color:var(--gold);border:1px solid var(--gold);}
.es-ready{background:#10b98122;color:var(--green);border:1px solid var(--green);}
.conf-wrap{
  background:#080e1f;
  border-radius:12px;
  padding:12px;
  margin-top:12px;
}
.conf-bar-bg{height:6px;background:#1e2d4a;border-radius:10px;overflow:hidden;margin:7px 0;}
.conf-bar-fill{height:100%;background:linear-gradient(90deg,var(--red),var(--gold),var(--green));border-radius:10px;transition:width .5s;}
.strat-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin-top:12px;
}
.strat-tile{
  border-radius:12px;
  padding:10px;
  border:1px solid;
  text-align:center;
  transition:.2s;
}
.strat-tile .st-name{
  font-size:0.6rem;
  font-weight:700;
  letter-spacing:1px;
  text-transform:uppercase;
  margin-bottom:4px;
}
.strat-tile .st-sig{font-size:0.85rem;font-weight:700;font-family:var(--fm);}
.strat-tile .st-conf{font-size:0.58rem;margin-top:3px;}
.strat-active{box-shadow:0 0 14px -4px currentColor;}
.ind-row{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:10px;
}
.ind-chip{
  padding:3px 10px;
  border-radius:20px;
  font-size:0.62rem;
  font-weight:700;
  border:1px solid;
}
.ind-bull{background:#10b98122;border-color:var(--green);color:var(--green);}
.ind-bear{background:#ef444422;border-color:var(--red);color:var(--red);}
.ind-neut{background:#f59e0b22;border-color:var(--gold);color:var(--gold);}
.logbox{
  background:#04060e;
  border-radius:12px;
  padding:14px;
  height:180px;
  overflow-y:auto;
  font-family:var(--fm);
  font-size:0.68rem;
  line-height:1.6;
}
.le{padding:2px 0;border-bottom:1px solid #1e2d4a22;}
.le.signal{color:var(--green);}
.le.error{color:var(--red);}
.le.warn{color:var(--gold);}
.le.info{color:var(--sub);}
.le.api{color:#8b5cf6;}
.chart-wrap{border-radius:14px;overflow:hidden;height:340px;}
.exec-copy-tile{
  background:#080e1f;
  border:1px solid var(--border);
  border-radius:14px;
  padding:14px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.exec-copy-btn{
  background:#1e2d4a;
  border:1px solid var(--border);
  border-radius:9px;
  color:var(--text);
  padding:7px 12px;
  font-size:0.72rem;
  font-family:var(--ff);
  font-weight:700;
  cursor:pointer;
  transition:.15s;
  text-align:left;
}
.exec-copy-btn:hover{background:var(--gold);color:#080e1f;border-color:var(--gold);}
.dtable{
  width:100%;
  border-collapse:collapse;
  font-size:0.75rem;
}
.dtable th{
  text-align:left;
  padding:9px 12px;
  font-size:0.6rem;
  color:var(--sub);
  text-transform:uppercase;
  letter-spacing:1px;
  border-bottom:1px solid var(--border);
}
.dtable td{
  padding:10px 12px;
  border-bottom:1px solid #1e2d4a22;
  font-family:var(--fm);
}
.sig-chip{
  display:inline-block;
  padding:2px 9px;
  border-radius:7px;
  font-size:0.65rem;
  font-weight:700;
}
.sc-BUY,.sc-SCALP-LONG{background:#10b98122;color:var(--green);border:1px solid var(--green);}
.sc-SELL,.sc-SCALP-SHORT{background:#ef444422;color:var(--red);border:1px solid var(--red);}
.sc-HOLD{background:#f59e0b22;color:var(--gold);border:1px solid var(--gold);}
.sc-OPTION-CALL{background:#3b82f622;color:var(--blue);border:1px solid var(--blue);}
.sc-OPTION-PUT{background:#8b5cf622;color:var(--purple);border:1px solid var(--purple);}
.sc-OPTION-BULL-SPREAD{background:#10b98133;color:var(--green);border:1px solid var(--green);}
.sc-OPTION-BEAR-SPREAD{background:#ef444433;color:var(--red);border:1px solid var(--red);}
.sc-OPTION-IRON-CONDOR{background:#f59e0b33;color:var(--gold);border:1px solid var(--gold);}
.info-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-bottom:16px;
}
.info-card{
  background:#080e1f;
  border:1px solid var(--border);
  border-radius:12px;
  padding:14px;
  text-align:center;
}
.info-card .ic-val{
  font-size:1.2rem;
  font-weight:800;
  font-family:var(--fm);
  color:var(--gold);
}
.info-card .ic-lbl{
  font-size:0.55rem;
  color:var(--sub);
  text-transform:uppercase;
  letter-spacing:1px;
  margin-top:4px;
}
.quality-badge{
  display:inline-block;
  padding:2px 10px;
  border-radius:12px;
  font-size:0.6rem;
  font-weight:700;
}
.q-aplus{background:#10b98133;color:var(--green);border:1px solid var(--green);}
.q-a{background:#10b98122;color:var(--green);border:1px solid var(--green);}
.q-b{background:#f59e0b33;color:var(--gold);border:1px solid var(--gold);}
.q-c{background:#f59e0b22;color:var(--gold);border:1px solid var(--gold);}
.q-d{background:#ef444433;color:var(--red);border:1px solid var(--red);}
.q-f{background:#ef444422;color:var(--red);border:1px solid var(--red);}
.fchip{display:inline-block;padding:4px 14px;border-radius:20px;font-size:0.7rem;font-weight:700;cursor:pointer;background:#1e2d4a;color:var(--sub);border:1px solid transparent;transition:.15s;}
.fchip.on{background:#f59e0b22;border-color:var(--gold);color:var(--gold);}
.fchip:hover{background:#1e2d4a88;}

.trade-type-toggle{display:flex;gap:4px;background:#080e1f;border-radius:10px;padding:3px;border:1px solid var(--border);margin-bottom:12px;}
.trade-type-toggle button{background:none;border:none;padding:6px 16px;border-radius:8px;font-family:var(--ff);font-size:0.7rem;font-weight:700;color:var(--sub);cursor:pointer;transition:.15s;}
.trade-type-toggle button.on{background:var(--gold);color:#080e1f;}
.trade-type-toggle button:hover:not(.on){color:var(--text);}

/* Sessions bar at top */
.sessions-bar{
  display:flex;
  gap:6px;
  padding:8px 12px;
  background:#080e1f;
  border-radius:12px;
  border:1px solid var(--border);
  margin-bottom:12px;
  flex-wrap:wrap;
  align-items:center;
  justify-content:center;
}
.session-chip{
  padding:3px 10px;
  border-radius:20px;
  font-size:0.6rem;
  font-weight:700;
  border:1px solid;
  transition:.3s;
}
.session-chip.active{
  box-shadow:0 0 12px -2px currentColor;
}
.session-chip .ses-time{font-weight:400;opacity:0.7;font-size:0.55rem;}
.sessions-bar .ses-label{font-size:0.55rem;color:var(--sub);text-transform:uppercase;letter-spacing:1px;margin-right:4px;}

/* Marquee styling - SLOWER SPEED */
.marquee-container{
  background:linear-gradient(90deg,#0c1526,#1e2d4a,#0c1526);
  border:1px solid var(--gold);
  border-radius:12px;
  padding:8px 0;
  margin-bottom:12px;
  overflow:hidden;
  position:relative;
  box-shadow:0 0 20px rgba(245,158,11,0.1);
}
.marquee-container::before{
  content:'✦';
  position:absolute;
  left:5px;
  top:50%;
  transform:translateY(-50%);
  color:var(--gold);
  font-size:0.8rem;
  animation:pulseStar 1.5s ease-in-out infinite;
  z-index:2;
}
.marquee-container::after{
  content:'✦';
  position:absolute;
  right:5px;
  top:50%;
  transform:translateY(-50%);
  color:var(--gold);
  font-size:0.8rem;

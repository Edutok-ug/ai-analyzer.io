function simData(asset){
  const base=BASE[asset]||1.2;
  const seed=Math.floor(Date.now()/60000);
  const seededRand=(n)=>{ let x=Math.sin(seed*9301+n*49297+asset.charCodeAt(0)*233)*10000; return x-Math.floor(x); };
  const drift=(seededRand(0)-0.48)*base*0.004;
  const price=base+drift;
  const n=200;
  let closes=[],highs=[],lows=[];
  let p=price;
  for(let i=0;i<n;i++){
    const chg=(seededRand(i+1)-0.49)*base*0.003;
    p=Math.max(base*0.95,p+chg);
    const hi=p*(1+seededRand(i+100)*0.002);
    const lo=p*(1-seededRand(i+200)*0.002);
    closes.push(p); highs.push(hi); lows.push(lo);
  }
  closes[n-1]=price; highs[n-1]=price*(1+seededRand(999)*0.002); lows[n-1]=price*(1-seededRand(998)*0.002);
  return buildIndicators(asset,price,closes,highs,lows);
}

function buildIndicators(asset,price,closes,highs,lows){
  const n=closes.length;
  let g=0,l=0;
  for(let i=Math.max(0,n-14);i<n-1;i++){const d=closes[i+1]-closes[i];if(d>=0)g+=d;else l-=d;}
  const rs=(g/14)/((l/14)||0.001);
  const rsi=parseFloat((100-100/(1+rs)).toFixed(1));
  let tr=[];
  for(let i=1;i<highs.length;i++) tr.push(Math.max(highs[i]-lows[i],Math.abs(highs[i]-closes[i-1]),Math.abs(lows[i]-closes[i-1])));
  let atr=tr.slice(0,14).reduce((a,b)=>a+b,0)/14;
  for(let i=14;i<tr.length;i++) atr=(atr*13+tr[i])/14;
  const ema=(arr,p)=>{let e=arr.slice(0,p).reduce((a,b)=>a+b,0)/p;for(let i=p;i<arr.length;i++)e=(arr[i]*(2/(p+1)))+(e*(1-2/(p+1)));return e;};
  const ema20=ema(closes.slice(-Math.min(20,n)),Math.min(20,n));
  const ema50=ema(closes.slice(-Math.min(50,n)),Math.min(50,n));
  const ema200=ema(closes.slice(-Math.min(n,n)),Math.min(n,n));
  let rets=[];for(let i=1;i<closes.length;i++) rets.push((closes[i]-closes[i-1])/closes[i-1]);
  const mean=rets.reduce((a,b)=>a+b,0)/rets.length;
  const vol=Math.sqrt(rets.reduce((a,b)=>a+Math.pow(b-mean,2),0)/rets.length)*100;

  function findSRZones(h,l,c2,atrVal){
    const tolerance=atrVal*0.4;
    const candidates=[];
    for(let j=2;j<h.length-2;j++){
      if(h[j]>h[j-1]&&h[j]>h[j-2]&&h[j]>h[j+1]&&h[j]>h[j+2])
        candidates.push({level:h[j],type:'resistance',idx:j});
      if(l[j]<l[j-1]&&l[j]<l[j-2]&&l[j]<l[j+1]&&l[j]<l[j+2])
        candidates.push({level:l[j],type:'support',idx:j});
    }
    const zones=[];
    candidates.forEach(cand=>{
      let merged=false;
      for(let k=0;k<zones.length;k++){
        if(Math.abs(zones[k].level-cand.level)<=tolerance){
          zones[k].level=(zones[k].level*zones[k].tests+cand.level)/(zones[k].tests+1);
          zones[k].tests++;
          zones[k].lastIdx=Math.max(zones[k].lastIdx,cand.idx);
          if(zones[k].type!==cand.type) zones[k].type='both';
          merged=true;break;
        }
      }
      if(!merged) zones.push({level:cand.level,type:cand.type,tests:1,lastIdx:cand.idx});
    });
    return zones.filter(z=>z.tests>=3).sort((a,b)=>b.tests-a.tests);
  }
  const srZones=findSRZones(highs,lows,closes,atr);
  const supportZones=srZones.filter(z=>z.level<price&&(z.type==='support'||z.type==='both'));
  const resistanceZones=srZones.filter(z=>z.level>price&&(z.type==='resistance'||z.type==='both'));
  const support=supportZones.length?supportZones[0].level:Math.min(...lows.slice(-20));
  const resistance=resistanceZones.length?resistanceZones[0].level:Math.max(...highs.slice(-20));
  let hh=0,ll=0;
  for(let i=2;i<Math.min(highs.length,10);i++){if(highs[i]>highs[i-2])hh++;if(lows[i]<lows[i-2])ll++;}
  const structure=hh>ll?'BULLISH':ll>hh?'BEARISH':'RANGING';
  const volSpike = vol > 1.5;
  const volDir = vol > 1.2 ? (Math.random() > 0.5 ? 'up' : 'down') : 'neutral';
  return {price,rsi,atr:parseFloat(atr.toFixed(asset==='BTCUSD'?0:5)),vol:parseFloat(vol.toFixed(2)),support,resistance,allSupportZones:supportZones,allResistanceZones:resistanceZones,srZones,ema20,ema50,ema200,closes,highs,lows,structure,volSpike,volDir};
}


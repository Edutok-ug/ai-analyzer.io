        if (lowIV) {
            strategy = 'OPTION-PUT';
            strategyName = 'Buy Put';
            strike = price - (atr * 0.3);
            premium = (atr * 0.15) * (1 - ivRank/200);
            maxProfit = 'Unlimited';

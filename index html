let tradeMonitorIv=null;

function openTrade(signal,entry,sl,tp,asset,tf,lot){
  if(activeTrade){toast('Close current trade first');return;}
  activeTrade={signal,entry,sl,tp,asset,tf,lot,openTime:Date.now(),originalSL:sl,originalTP:tp,
    breakEvenMoved:false,partialClosed:false,trailingActive:false,status:'OPEN',pnl:0,highWater:entry,lowWater:entry};
  
  renderTradeManager();
  if(tradeMonitorIv) clearInterval(tradeMonitorIv);
  tradeMonitorIv=setInterval(monitorTrade,5000);
  addLog('✅ Trade OPENED: '+asset+' '+signal+' @ '+fp(asset,entry),'signal');
  toast('✅ Trade opened');
}

function monitorTrade(){
  if(!activeTrade||activeTrade.status!=='OPEN') return;
  const price=curMkt.price||activeTrade.entry;
  const isBuy=activeTrade.signal==='BUY'||activeTrade.signal==='SCALP-LONG'||activeTrade.signal==='OPTION-CALL'||activeTrade.signal==='OPTION-BULL-SPREAD';
  const atr=curMkt.atr||Math.abs(activeTrade.originalTP-activeTrade.entry)/2.5||0.001;
  const pips=isBuy?price-activeTrade.entry:activeTrade.entry-price;
  
  if(isBuy) activeTrade.highWater=Math.max(activeTrade.highWater||price,price);
  else activeTrade.lowWater=Math.min(activeTrade.lowWater||price,price);
  
  const exits=calculateAdvancedExits(activeTrade,price,atr);
  const sortedExits=exits.sort((a,b)=>Math.abs(a.price-price)-Math.abs(b.price-price));
  for(const exit of sortedExits){
    const hit=isBuy?price>=exit.price:price<=exit.price;
    if(hit){
      if(exit.size<1){
        const pipVal=activeTrade.asset==='XAUUSD'?100:activeTrade.asset==='BTCUSD'?1:100000;
        const pnl=parseFloat((pips*activeTrade.lot*exit.size*pipVal).toFixed(2));
        toast('🎯 Partial: '+exit.reason+' | +$'+pnl);
        addLog('📊 Partial exit: '+exit.reason+' | +$'+pnl,'signal');
        activeTrade.lot=activeTrade.lot*(1-exit.size);
        activeTrade.partialClosed=true;
      } else {
        closeTrade(exit.type,price);
        return;
      }
    }
  }
  
  if(!activeTrade.breakEvenMoved && pips>=atr*1.0){
    activeTrade.sl=activeTrade.entry;
    activeTrade.breakEvenMoved=true;
    toast('🔒 Break-even triggered');
  }
  
  if(pips>=atr*1.5){
    activeTrade.trailingActive=true;
    const newSL=isBuy?price-atr*0.8:price+atr*0.8;
    if(isBuy&&newSL>activeTrade.sl) activeTrade.sl=newSL;
    if(!isBuy&&newSL<activeTrade.sl) activeTrade.sl=newSL;
  }
  
  const slHit=isBuy?price<=activeTrade.sl:price>=activeTrade.sl;
  if(slHit){closeTrade('SL',price);return;}
  const tpHit=isBuy?price>=activeTrade.tp:price<=activeTrade.tp;
  if(tpHit){closeTrade('TP',price);return;}
  
  const pipVal=activeTrade.asset==='XAUUSD'?100:activeTrade.asset==='BTCUSD'?1:100000;
  activeTrade.pnl=parseFloat((pips*activeTrade.lot*pipVal*(activeTrade.partialClosed?0.5:1)).toFixed(2));
  
  renderTradeManager();
}

function closeTrade(reason,closePrice){
  if(!activeTrade) return;
  const isBuy=activeTrade.signal==='BUY'||activeTrade.signal==='SCALP-LONG'||activeTrade.signal==='OPTION-CALL'||activeTrade.signal==='OPTION-BULL-SPREAD';
  const pips=isBuy?closePrice-activeTrade.entry:activeTrade.entry-closePrice;
  const pipVal=activeTrade.asset==='XAUUSD'?100:activeTrade.asset==='BTCUSD'?1:100000;
  const pnl=parseFloat((pips*activeTrade.lot*pipVal).toFixed(2));
  const result=pnl>0?'WIN':'LOSS';
  
  journal.unshift({id:Date.now(),time:new Date().toLocaleString(),asset:activeTrade.asset,
    tf:activeTrade.tf,signal:activeTrade.signal,entry:activeTrade.entry,
    sl:activeTrade.originalSL,tp:activeTrade.originalTP,closePrice,result,pnl,
    quality:curSig.quality||0,grade:curSig.grade||'--'});
  localStorage.setItem('qep_journal',JSON.stringify(journal));
  
  activeTrade=null;
  if(tradeMonitorIv){clearInterval(tradeMonitorIv);tradeMonitorIv=null;}
  renderTradeManager(); renderJ('all');
  toast(result==='WIN'?'✅ WIN $'+pnl:'❌ LOSS $'+Math.abs(pnl));
}


function aiChooseStrategy(votes,d,isScalp){
  const total=votes.length;
  let buySum=0,buyCount=0,sellSum=0,sellCount=0;
  votes.forEach(function(v){
    const isBuy=v.signal==='BUY'||v.signal==='SCALP-LONG';
    const isSell=v.signal==='SELL'||v.signal==='SCALP-SHORT';
    if(isBuy){ buySum+=v.conf; buyCount++; } else if(isSell){ sellSum+=v.conf; sellCount++; }
  });
  const buyAvg=buyCount?buySum/buyCount:0;
  const sellAvg=sellCount?sellSum/sellCount:0;
  let signal='HOLD', conf=25, chosenStrat='NEUTRAL', reasoning='';
  
  // FIXED: Properly detect SELL signals
  if(sellAvg > buyAvg && sellAvg > 30){
    signal=isScalp?'SCALP-SHORT':'SELL';
    conf=Math.min(95,Math.round(sellAvg+sellCount*2));
    chosenStrat='SELL ('+sellCount+'/'+total+' strategies)';
    reasoning=sellCount+' strategies SELL, '+buyCount+' BUY.';
  } else if(buyAvg>sellAvg && buyAvg>30){
    signal=isScalp?'SCALP-LONG':'BUY';
    conf=Math.min(95,Math.round(buyAvg+buyCount*2));
    chosenStrat='BUY ('+buyCount+'/'+total+' strategies)';
    reasoning=buyCount+' strategies BUY, '+sellCount+' SELL.';
  } else {
    signal='HOLD';
    conf=Math.max(15,Math.round((buyAvg+sellAvg)/2));
    chosenStrat='CONFLICTED — WAIT';
    reasoning='Mixed signals. BUY avg '+Math.round(buyAvg)+'%, SELL avg '+Math.round(sellAvg)+'%.';
  }
  const confluence=Math.max(buyCount,sellCount);
  return {signal,conf,strategy:chosenStrat,reasoning,confluence,buyCount,sellCount,totalStrats:total,weightedScore:conf};
}

function calcForecastEntry(signal,d,isScalp){
  const price=d.price;
  const atr=d.atr;
  const isBuy=signal==='BUY'||signal==='SCALP-LONG'||signal==='OPTION-CALL'||signal==='OPTION-BULL-SPREAD';
  const isSell=signal==='SELL'||signal==='SCALP-SHORT'||signal==='OPTION-PUT'||signal==='OPTION-BEAR-SPREAD';
  let entry=price, sl=null, tp=null, entryType='Market', quality='MARKET';
  
  if(isBuy){
    const bestSup=(d.allSupportZones||[]).filter(z=>z.level<price-atr*0.2);
    if(bestSup.length){
      const z=bestSup[0];
      entry=z.level+atr*0.1; sl=z.level-atr*0.2; tp=entry+(entry-sl)*3;
      entryType='Support ('+z.tests+'x tested)';
      quality=z.tests>=5?'ELITE':z.tests>=4?'STRONG':'SOLID';
    } else {
      entry=price-atr*0.8; sl=entry-atr*1.0; tp=entry+(entry-sl)*3;
    }
  } else if(isSell){
    // FIXED: Proper SELL entry calculation using resistance zones
    const bestRes=(d.allResistanceZones||[]).filter(z=>z.level>price+atr*0.2);
    if(bestRes.length){
      const z=bestRes[0];
      entry=z.level-atr*0.1; sl=z.level+atr*0.2; tp=entry-(sl-entry)*3;
      entryType='Resistance ('+z.tests+'x tested)';
      quality=z.tests>=5?'ELITE':z.tests>=4?'STRONG':'SOLID';
    } else {
      // If no resistance zones found, use ATR-based entry
      entry=price+atr*0.8; sl=entry+atr*1.0; tp=entry-(sl-entry)*3;
      entryType='ATR Resistance';
      quality='AVERAGE';
    }
  }
  
  entry=Math.max(price-atr*3,Math.min(price+atr*3,entry));
  if(isBuy){ 
    sl=Math.min(entry-atr*0.2,sl||entry-atr*1.0); 
    tp=Math.max(entry+atr*2.0,tp||entry+atr*3.0); 
  } else if(isSell){ 
    sl=Math.max(entry+atr*0.2,sl||entry+atr*1.0); 
    tp=Math.min(entry-atr*2.0,tp||entry-atr*3.0); 
  }
  const risk=Math.abs(entry-sl); const reward=Math.abs(tp-entry);
  const rr=risk>0?(reward/risk).toFixed(1):'0';
  return {entry,sl,tp,entryType,quality,rr,risk,reward};
}


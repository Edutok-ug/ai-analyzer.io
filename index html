            delta = -0.55 - (1 - (ivRank/100)) * 0.2;
            theta = -0.02 - (ivRank/5000);
            probITM = 45 + (ivRank/4);
            description = 'Bearish + Low IV = Buy cheap puts';
        } else if (highIV) {
            strategy = 'OPTION-BEAR-SPREAD';
            strategyName = 'Bear Call Spread';
            const strike1 = price + (atr * 0.5);
            const strike2 = price + (atr * 1.2);
            strike = strike1;
            premium = (strike2 - strike1) * 0.3;
            maxProfit = '$' + premium.toFixed(2);
            maxLoss = '$' + ((strike2 - strike1) - premium).toFixed(2);
            breakEven = strike1 + premium;
            delta = -0.35;
            theta = 0.04 + (ivRank/3000);
            probITM = 70 + (ivRank/6);
            description = 'Bearish + High IV = Sell call spread';
        } else {
            strategy = 'OPTION-PUT';
            strategyName = 'Buy Put (Neutral IV)';
            strike = price - (atr * 0.4);
            premium = atr * 0.18;
            maxProfit = 'Unlimited';
            maxLoss = '$' + premium.toFixed(2);
            breakEven = strike - premium;
            delta = -0.50;
            theta = -0.03;
            probITM = 50;
            description = 'Bearish with moderate IV';
        }
    } else if (cfdSignal === 'HOLD' && highIV) {
        // Neutral with high IV - Iron Condor
        strategy = 'OPTION-IRON-CONDOR';
        strategyName = 'Iron Condor';
        const upperStrike = price + (atr * 1.5);
        const lowerStrike = price - (atr * 1.5);
        strike = price;
        premium = (atr * 0.25) * (ivRank/50);
        maxProfit = '$' + premium.toFixed(2);
        maxLoss = '$' + (atr * 0.5).toFixed(2);
        breakEven = price;
        delta = 0;
        theta = 0.08 + (ivRank/2000);
        probITM = 85;
        description = 'Neutral + High IV = Iron Condor';
    } else if (cfdSignal === 'HOLD' && lowIV) {
        // Neutral with low IV - wait or straddle
        strategy = 'HOLD';
        strategyName = 'Wait';
        description = 'Neutral + Low IV = Wait for better opportunity';
    }
    
    const expiryOptions = ['0DTE', '1DTE', '7DTE', '14DTE', '30DTE'];
    const expiryIdx = Math.min(4, Math.max(1, Math.floor(ivRank / 25)));

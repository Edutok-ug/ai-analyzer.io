        theta: theta.toFixed(3),
        probITM: Math.min(95, Math.max(5, probITM)).toFixed(0) + '%',
        ivRank: ivRank.toFixed(0) + '%',
        description,
        forecastEntry: strike,
        forecastSL: breakEven,
        forecastTP: price
    };
}


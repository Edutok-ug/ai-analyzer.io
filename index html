function renderJ(f){
  let data=journal;
  if(f&&f!=='all') data=data.filter(d=>d.signal===f);
  const wins=journal.filter(d=>d.result==='WIN').length;
  const loss=journal.filter(d=>d.result==='LOSS').length;
  const totalTrades = journal.length;
  document.getElementById('jTotal').textContent = totalTrades;
  document.getElementById('jWins').textContent = wins;
  document.getElementById('jLoss').textContent = loss;
  const winRate = wins+loss>0 ? Math.round(wins/(wins+loss)*100) : 0;
  document.getElementById('jWR').textContent = winRate+'%';
  
  const avgQuality=totalTrades>0?journal.reduce((sum,d)=>sum+(d.quality||50),0)/totalTrades:0;
  const avgRR=totalTrades>0?journal.reduce((sum,d)=>{
    const rr=d.tp&&d.sl?Math.abs(d.tp-d.entry)/Math.abs(d.sl-d.entry):0;
    return sum+rr;
  },0)/totalTrades:0;
  document.getElementById('statWR').textContent=winRate+'%';
  document.getElementById('statWR').style.color=winRate>50?'var(--green)':'var(--red)';
  document.getElementById('statQuality').textContent=Math.round(avgQuality)+'%';
  document.getElementById('statQuality').style.color=avgQuality>65?'var(--green)':avgQuality>50?'var(--gold)':'var(--red)';
  document.getElementById('statRR').textContent=avgRR.toFixed(1)+'R';
  document.getElementById('statTotal').textContent=totalTrades;
  
  if(!data.length){document.getElementById('jBody').innerHTML='<tr><td colspan="11" style="text-align:center;padding:20px;color:var(--muted);">No entries.</td></tr>';return;}
  document.getElementById('jBody').innerHTML=data.map(d=>{
    const sigClass='sig-chip sc-'+d.signal;
    const resultColor=d.result==='WIN'?'var(--green)':d.result==='LOSS'?'var(--red)':'var(--sub)';
    const gradeClass = d.grade === 'A+' ? 'q-aplus' : d.grade === 'A' ? 'q-a' : d.grade === 'B' ? 'q-b' : d.grade === 'C' ? 'q-c' : 'q-d';
    return `<tr>
      <td style="font-size:0.62rem;">${d.time}</td>
      <td>${d.asset}</td>
      <td>${d.tf}</td>
      <td><span class="${sigClass}">${d.signal}</span></td>
      <td style="font-family:var(--fm);">${fp(d.asset,d.entry)}</td>
      <td style="font-family:var(--fm);color:var(--red);">${d.sl?fp(d.asset,d.sl):'--'}</td>
      <td style="font-family:var(--fm);color:var(--green);">${d.tp?fp(d.asset,d.tp):'--'}</td>
      <td>${d.conf||'--'}%</td>
      <td style="font-size:0.62rem;">${(d.strategy||'').substring(0,15)}</td>
      <td><span class="quality-badge ${gradeClass}">${d.grade||'--'}</span></td>
      <td style="color:${resultColor};font-weight:700;">${d.result||'PENDING'}</td>
    </tr>`;
  }).join('');
}

